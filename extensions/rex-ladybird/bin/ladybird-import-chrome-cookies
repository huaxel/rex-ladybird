#!/usr/bin/env python3
"""Import cookies from a Chrome profile into a Ladybird profile.

Both formats are understood as they exist today:
  * Chrome  (macOS): AES-128-CBC, key = PBKDF2-SHA1(Keychain "Chrome Safe Storage",
    "saltysalt", 1003 iters, 16 bytes), IV = 16 spaces, "v10" prefix, DB version >= 24
    prepends SHA256(host_key) to the plaintext.
  * Ladybird: plaintext TEXT in the `Cookies` table of <profile>/data/Ladybird.db,
    times in microseconds since the Unix epoch, SameSite Default/None/Strict/Lax = 0/1/2/3.

Defaults to a dry run. Pass --write to change the Ladybird profile, which must not be
in use by a running Ladybird process.
"""

from __future__ import annotations

import argparse
import hashlib
import os
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time

CHROME_EPOCH_OFFSET_US = 11_644_473_600_000_000  # 1601-01-01 -> 1970-01-01
LADYBIRD_SESSION_EXPIRY_US = 32_503_680_000_000_000  # year 3000, as CookieJar stores it

# Chrome samesite: -1 unspecified, 0 none, 1 lax, 2 strict.
# Ladybird HTTP::Cookie::SameSite: Default, None, Strict, Lax.
SAME_SITE = {-1: 0, 0: 1, 1: 3, 2: 2}


def chrome_key() -> bytes:
    password = subprocess.run(
        ["security", "find-generic-password", "-w", "-s", "Chrome Safe Storage"],
        check=True,
        capture_output=True,
    ).stdout.strip()
    return hashlib.pbkdf2_hmac("sha1", password, b"saltysalt", 1003, 16)


def decrypt(encrypted: bytes, host_key: str, key: bytes, db_version: int) -> bytes | None:
    if not encrypted.startswith(b"v10"):
        return None
    ciphertext = encrypted[3:]
    result = subprocess.run(
        [
            "openssl", "enc", "-d", "-aes-128-cbc", "-nopad",
            "-K", key.hex(), "-iv", (b" " * 16).hex(),
        ],
        input=ciphertext,
        capture_output=True,
    )
    if result.returncode != 0:
        return None
    plain = result.stdout
    if not plain:
        return None
    pad = plain[-1]
    if pad < 1 or pad > 16 or plain[-pad:] != bytes([pad]) * pad:
        return None
    plain = plain[:-pad]
    if db_version >= 24:
        # The plaintext starts with SHA256(host_key), a binding check Chrome added in v24.
        digest = hashlib.sha256(host_key.encode()).digest()
        if plain[:32] != digest:
            return None
        plain = plain[32:]
    return plain


def snapshot_chrome_db(profile_dir: str) -> str:
    directory = tempfile.mkdtemp(prefix="chrome-cookies-")
    for suffix in ("", "-wal", "-shm"):
        source = os.path.join(profile_dir, "Cookies" + suffix)
        if os.path.exists(source):
            shutil.copy2(source, os.path.join(directory, "Cookies" + suffix))
    return directory


def ladybird_is_running(profile_path: str) -> bool:
    needle = os.path.realpath(profile_path)
    result = subprocess.run(["ps", "-Ao", "command"], capture_output=True, text=True)
    for line in result.stdout.splitlines():
        if "Ladybird" not in line:
            continue
        for token in line.split():
            if token.startswith("--profile-path=") and os.path.realpath(token.split("=", 1)[1]) == needle:
                return True
    return False


def main() -> int:
    home = os.path.expanduser("~")
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--chrome-profile", default=os.path.join(home, "Library/Application Support/Google/Chrome/Default"))
    parser.add_argument("--ladybird-profile", default=os.path.join(home, ".local/share/ladybird-terminal-profile"))
    parser.add_argument("--only", action="append", default=[], metavar="DOMAIN",
                        help="restrict to a host suffix, e.g. --only github.com (repeatable)")
    parser.add_argument("--write", action="store_true", help="actually modify the Ladybird profile")
    args = parser.parse_args()

    if not os.path.exists(os.path.join(args.chrome_profile, "Cookies")):
        print(f"no Chrome cookie database at {args.chrome_profile}", file=sys.stderr)
        return 1

    ladybird_db = os.path.join(args.ladybird_profile, "data", "Ladybird.db")
    if args.write:
        if not os.path.exists(ladybird_db):
            print(f"no Ladybird profile at {args.ladybird_profile}", file=sys.stderr)
            return 1
        if ladybird_is_running(args.ladybird_profile):
            print("Ladybird is using that profile; quit it first (ctrl-q in the terminal window)", file=sys.stderr)
            return 1

    directory = snapshot_chrome_db(args.chrome_profile)
    try:
        chrome = sqlite3.connect(f"file:{directory}/Cookies?mode=ro", uri=True)
        version = int(chrome.execute("select value from meta where key = 'version'").fetchone()[0])
        key = chrome_key()
        now_us = int(time.time() * 1_000_000)

        rows = chrome.execute(
            "select host_key, name, path, expires_utc, is_secure, is_httponly, samesite,"
            " has_expires, is_persistent, creation_utc, last_access_utc, encrypted_value"
            " from cookies"
        ).fetchall()

        imported, expired, failed, filtered = [], 0, 0, 0
        for (host_key, name, path, expires_utc, is_secure, is_httponly, samesite,
             has_expires, is_persistent, creation_utc, last_access_utc, encrypted) in rows:
            if args.only and not any(host_key.lstrip(".").endswith(d) for d in args.only):
                filtered += 1
                continue
            expiry_us = (expires_utc - CHROME_EPOCH_OFFSET_US) if has_expires else LADYBIRD_SESSION_EXPIRY_US
            if has_expires and expiry_us < now_us:
                expired += 1
                continue
            value = decrypt(encrypted, host_key, key, version)
            if value is None:
                failed += 1
                continue
            host_only = not host_key.startswith(".")
            imported.append((
                name,
                value.decode("utf-8", "replace"),
                SAME_SITE.get(samesite, 0),
                creation_utc - CHROME_EPOCH_OFFSET_US,
                last_access_utc - CHROME_EPOCH_OFFSET_US,
                expiry_us,
                host_key.lstrip(".") if not host_only else host_key,
                path,
                int(bool(is_secure)),
                int(bool(is_httponly)),
                int(host_only),
                int(bool(is_persistent)),
                "",
            ))
    finally:
        shutil.rmtree(directory, ignore_errors=True)

    print(f"chrome db version {version}: {len(rows)} cookies, {len(imported)} usable, "
          f"{expired} expired, {failed} undecryptable, {filtered} filtered")
    hosts = sorted({row[6] for row in imported})
    print(f"{len(hosts)} hosts, e.g. {', '.join(hosts[:8])}")

    if failed:
        print(f"note: {failed} cookies use an encryption format this script does not handle", file=sys.stderr)

    if not args.write:
        print("dry run: nothing written (pass --write to import)")
        return 0 if imported else 1

    database = sqlite3.connect(ladybird_db)
    with database:
        database.executemany(
            "INSERT OR REPLACE INTO Cookies (name, value, same_site, creation_time, last_access_time,"
            " expiry_time, domain, path, secure, http_only, host_only, persistent, partition_key)"
            " VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)",
            imported,
        )
        database.execute("DELETE FROM Cookies WHERE expiry_time < ?", (now_us,))
    total = database.execute("select count(*) from Cookies").fetchone()[0]
    database.close()
    print(f"wrote {len(imported)} cookies; profile now holds {total}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

<script>
const narrow = matchMedia("(max-width: 42rem)");
const sidebar = document.getElementById("sidebar");
const listError = document.getElementById("list-error");
const rows = document.getElementById("sessions");
const text = document.getElementById("text");
const label = document.getElementById("label");
const dot = document.getElementById("dot");
const state = document.getElementById("state");
const note = document.getElementById("note");
const live = document.getElementById("live");
const livedot = document.getElementById("livedot");
const livetext = document.getElementById("livetext");
const follow = document.getElementById("follow");
let selected = null;      // block id
let listTimer = null;
let listBusy = false;
let listDirty = false;
let transcriptBusy = false;
let safety = null;        // fallback poll, only while the stream is not open

async function get(url) {
  const response = await fetch(url, { cache: "no-store" });
  const body = await response.json().catch(() => null);
  if (!response.ok) throw new Error((body && body.error) || response.statusText);
  return body;
}

function say(message, warn) {
  note.textContent = message;
  note.dataset.warn = warn ? "true" : "false";
}

function blockRow(block) {
  const row = document.createElement("button");
  row.className = "block";
  row.dataset.block = block.id;
  row.setAttribute("aria-current", block.id === selected ? "true" : "false");
  const light = document.createElement("span");
  light.className = "dot " + block.state;
  light.title = block.state + (block.kind ? " (" + block.kind + ")" : "");
  const where = document.createElement("span");
  where.className = "where";
  // Rex labels a block by its program, so several terminals are all "shell".
  // The reporting program is the part that tells them apart.
  const generic = ["shell", "terminal", "login"].includes(block.label.toLowerCase());
  where.textContent = generic && block.app ? block.app : block.label;
  const app = document.createElement("span");
  app.className = "app";
  app.textContent = block.state === "blocked" ? block.kind || "needs you" : generic ? "" : block.app || "";
  row.append(light, where, app);
  row.addEventListener("click", () => {
    if (narrow.matches) document.body.setAttribute("data-detail", "");
    choose(block);
    if (narrow.matches) label.focus();
  });
  return row;
}

function heading(text) {
  const element = document.createElement("h1");
  element.textContent = text;
  return element;
}

function rowFor(id) {
  return rows.querySelector(`button[data-block="${CSS.escape(id)}"]`);
}

function focusSessions(id) {
  (id && rowFor(id) || sidebar).focus({ preventScroll: true });
}

function render(sessions) {
  const focused = rows.contains(document.activeElement) ? document.activeElement.dataset.block : null;
  rows.replaceChildren();
  if (!sessions.length) {
    rows.append(heading("No sessions"));
    if (focused) focusSessions(null);
    return;
  }
  // Two lists, not one: a single heading over everything read as though every
  // session below it wanted a person.
  const waiting = sessions.filter((session) => session.needs_you);
  const rest = sessions.filter((session) => !session.needs_you);
  if (waiting.length) {
    rows.append(heading("Needs you (" + waiting.length + ")"));
    for (const session of waiting) rows.append(sessionGroup(session));
  }
  if (rest.length) {
    rows.append(heading(waiting.length ? "Everything else" : "Sessions"));
    for (const session of rest) rows.append(sessionGroup(session));
  }
  if (focused) focusSessions(focused);
}

function sessionGroup(session) {
  const group = document.createElement("div");
  group.className = "session";
  const name = document.createElement("div");
  name.className = "name";
  const light = document.createElement("span");
  light.className = "dot " + session.state;
  const text = document.createElement("span");
  text.textContent = session.label;
  name.append(light, text);
  group.append(name);
  for (const block of session.blocks) group.append(blockRow(block));
  if (!session.blocks.length) {
    const none = document.createElement("div");
    none.className = "name";
    none.textContent = "no terminals";
    group.append(none);
  }
  return group;
}

async function loadSessions() {
  if (listBusy) { listDirty = true; return; }
  listBusy = true;
  try {
    const body = await get("/api/sessions");
    listError.textContent = "";
    render(body.sessions);
    const blocks = body.sessions.flatMap((s) => s.blocks);
    const current = blocks.find((block) => block.id === selected);
    if (current) showStatus(current);
    else if (!narrow.matches && blocks.length) choose(blocks[0]);
    else {
      const wasDetail = document.body.hasAttribute("data-detail");
      document.body.removeAttribute("data-detail");
      if (narrow.matches && wasDetail) focusSessions(null);
      selected = null;
      text.textContent = "";
      label.textContent = "No block selected";
      state.textContent = "";
      dot.className = "dot";
    }
  } catch (error) {
    listError.textContent = "Rex: " + error.message;
  } finally {
    listBusy = false;
    if (listDirty) { listDirty = false; scheduleSessions(); }
  }
}

async function loadTranscript(block) {
  const body = await get("/api/transcript?block=" + encodeURIComponent(block));
  if (block !== selected) return;              // a slower reply for a block the person left
  const atBottom = text.scrollHeight - text.scrollTop - text.clientHeight < 40;
  text.textContent = body.content;
  if (atBottom) text.scrollTop = text.scrollHeight;
  label.textContent = body.title || block;
  if (body.truncated) {
    say("This terminal holds more output than one reply: what you see starts at the oldest line.", true);
  } else if (body.trimmed) {
    say("Showing the end of the scrollback. Read-only — type in the terminal, not here.", false);
  } else {
    say("Read-only. Type in the terminal, not here.", false);
  }
}

function setLive(state, detail) {
  const known = { live: "working", connecting: "working", down: "blocked" };
  livedot.className = "dot " + (known[state] || "unknown");
  livetext.textContent = state === "live" ? "live" : detail || state;
  live.title = detail || state;
}

function showStatus(block) {
  dot.className = "dot " + block.state;
  state.textContent = block.state + (block.kind ? " · " + block.kind : "") + (block.message ? " · " + block.message : "");
}

async function choose(block) {
  selected = block.id;
  text.textContent = "";
  label.textContent = block.label;
  showStatus(block);
  for (const row of rows.querySelectorAll("button.block")) {
    row.setAttribute("aria-current", row.dataset.block === block.id ? "true" : "false");
  }
  try { await loadTranscript(block.id); }
  catch (error) { if (block.id === selected) say("Rex: " + error.message, true); }
}

function setFollow(on) {
  follow.setAttribute("aria-pressed", on ? "true" : "false");
}

function scheduleSessions() {
  if (listTimer !== null) return;
  listTimer = setTimeout(() => { listTimer = null; loadSessions(); }, 300);
}

function connectionState(state, detail) {
  setLive(state, detail);
  if (state === "live") {
    if (safety !== null) clearInterval(safety);
    safety = null;
  } else if (safety === null) {
    safety = setInterval(loadSessions, 5000);
  }
}

function connect() {
  const source = new EventSource("/api/stream");
  source.onmessage = (message) => {
    const frame = JSON.parse(message.data);
    connectionState(frame.state, frame.error);
    if (frame.sessions) scheduleSessions();
  };
  source.onerror = () => connectionState("connecting", "reconnecting");
}

async function refreshTranscript() {
  if (!selected || transcriptBusy) return;
  const block = selected;
  transcriptBusy = true;
  try { await loadTranscript(block); }
  catch (error) { if (block === selected) say("Rex: " + error.message, true); }
  finally { transcriptBusy = false; }
}

setInterval(() => {
  const showingDetail = !narrow.matches || document.body.hasAttribute("data-detail");
  if (showingDetail && !document.hidden && follow.getAttribute("aria-pressed") === "true") refreshTranscript();
}, 2000);

document.getElementById("back").addEventListener("click", () => {
  document.body.removeAttribute("data-detail");
  focusSessions(selected);
});
narrow.addEventListener("change", () => {
  if (!narrow.matches && !selected) loadSessions();
});
follow.addEventListener("click", () => setFollow(follow.getAttribute("aria-pressed") !== "true"));
document.getElementById("refresh").addEventListener("click", () => {
  refreshTranscript();
  loadSessions();
});
setFollow(true);
loadSessions();
connect();
</script>
</html>
"""


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--port", type=int, default=8787, help="port to listen on; 0 picks a free one")
    parser.add_argument("--tail", type=int, default=DEFAULT_TAIL, help="characters of scrollback to show")
    args = parser.parse_args()

    server = Server(("127.0.0.1", args.port), Handler)
    server.tail = max(1_000, args.tail)
    print(f"http://127.0.0.1:{server.server_port}/", flush=True)

    def stop_on_signal(signum, frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, stop_on_signal)
    WATCHER.start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print()
    finally:
        WATCHER.stop()
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env python3
"""Control a running Ladybird from the command line.

Two surfaces, both built into Ladybird, neither requiring a patch:

  * the Firefox Remote Debugging Protocol server that --devtools=PORT starts,
    which knows every tab's real URL and title and can evaluate JavaScript;
  * the APC command channel terminal mode reads from its stdin,
    ESC _ ladybird;<command>;<argument> ESC \\, which navigates, goes back and
    forwards, reloads and quits.

State lives in ~/.local/state/rex-ladybird/ (block id and devtools port), shared
with the rex-ladybird module, so the CLI and the Rex pickers drive the same pane.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import socket
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
# The same directory the Rex module writes: ${XDG_STATE_HOME:-~/.local/state}.
STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"),
    "rex-ladybird",
)
BLOCK_FILE = os.path.join(STATE_DIR, "current")
PORT_FILE = os.path.join(STATE_DIR, "port")


# ---------------------------------------------------------------- Rex surface


def block_id() -> str | None:
    try:
        with open(BLOCK_FILE) as file:
            value = file.read().strip()
    except OSError:
        return None
    return value or None


def rex(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(["rex", *args], capture_output=True, text=True, check=check)


def pane_block() -> str:
    """The Rex block this CLI drives: the pane the module recorded."""
    block = block_id()
    if not block:
        sys.exit("no Ladybird pane recorded; open one with the Rex action ladybird_new")
    return block


def terminal_write(payload: str) -> None:
    block = pane_block()
    result = rex("send", "-b", block, payload, check=False)
    if result.returncode != 0:
        sys.exit(f"could not write to {block}: {result.stderr.strip()}")


def send_keys(block: str, keys: list[str]) -> None:
    """Press keys in the pane. These are the keystrokes a person would make, not
    synthetic events, so a control that listens to the keyboard sees them."""
    result = rex("send-key", "-b", block, *keys, check=False)
    if result.returncode != 0:
        sys.exit(f"could not send {', '.join(keys)} to {block}: {result.stderr.strip()}")


def apc(command: str, argument: str = "") -> None:
    terminal_write(f"\x1b_ladybird;{command};{argument}\x1b\\" if argument else f"\x1b_ladybird;{command}\x1b\\")


def status_line_url() -> str | None:
    """Read the address off the status line, for panes started without --devtools."""
    block = block_id()
    if not block:
        return None
    result = rex("capture", "-b", block, check=False)
    if result.returncode != 0:
        return None
    for line in result.stdout.splitlines():
        if "● " in line and " — " in line:
            tail = line.split(" — ", 1)[1].strip()
            url = tail.split()[0] if tail else ""
            if "://" in url:
                return url
    return None


# ----------------------------------------------------------------- RDP client


class RDP:
    """Just enough of the Firefox Remote Debugging Protocol for browsing."""

    def __init__(self, port: int, timeout: float = 10):
        self.socket = socket.create_connection(("127.0.0.1", port), timeout=timeout)
        self.buffer = b""
        self.timeout = timeout
        self.read_packet()  # the server's greeting

    def close(self) -> None:
        self.socket.close()

    def read_packet(self) -> dict:
        while b":" not in self.buffer:
            chunk = self.socket.recv(65536)
            if not chunk:
                raise ConnectionError("devtools connection closed")
            self.buffer += chunk
        length, _, rest = self.buffer.partition(b":")
        size = int(length)
        while len(rest) < size:
            chunk = self.socket.recv(65536)
            if not chunk:
                raise ConnectionError("devtools connection closed")
            rest += chunk
        self.buffer = rest[size:]
        return json.loads(rest[:size])

    def send(self, **packet) -> None:
        to = packet.pop("to", "root")
        body = json.dumps({"to": to, "type": packet.pop("type"), **packet}).encode()
        self.socket.sendall(b"%d:" % len(body) + body)

    def wait_for(self, predicate, timeout: float | None = None):
        deadline = time.monotonic() + (timeout or self.timeout)
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None
            self.socket.settimeout(remaining)
            try:
                packet = self.read_packet()
            except socket.timeout:
                return None
            if predicate(packet):
                return packet

    def request(self, **packet):
        """Send a request and return the reply or error for that actor."""
        to = packet.get("to", "root")
        packet_type = packet.get("type")
        self.send(**packet)
        reply = self.wait_for(
            lambda p: p.get("from") == to
            and (p.get("type") == packet_type or "error" in p or ("resultID" not in p and p.get("type") is None))
        )
        if reply is None:
            raise TimeoutError(f"no reply to {packet_type} from {to}")
        return reply

    def tab(self) -> dict:
        reply = self.request(type="listTabs")
        tabs = reply.get("tabs") or []
        if not tabs:
            raise RuntimeError("the browser has no open tab")
        return tabs[0]

    def frame(self) -> dict:
        """The frame target plus its console and navigation actors."""
        tab = self.tab()
        watcher = self.request(to=tab["actor"], type="getWatcher")
        if "actor" not in watcher:
            raise RuntimeError(f"could not get a watcher: {watcher}")
        self.send(to=watcher["actor"], type="watchTargets", targetType="frame")
        packet = self.wait_for(lambda p: p.get("type") == "target-available-form")
        if packet is None:
            raise RuntimeError("the tab never offered a frame target")
        return packet["target"]

    def evaluate(self, script: str):
        frame = self.frame()
        console = frame["consoleActor"]
        self.send(to=console, type="evaluateJSAsync", text=script)
        ack = self.wait_for(lambda p: p.get("from") == console and "resultID" in p)
        if ack is None:
            raise RuntimeError("the console actor did not accept the script")
        result = self.wait_for(
            lambda p: p.get("from") == console and p.get("type") == "evaluationResult"
            and p.get("resultID") == ack["resultID"]
        )
        if result is None:
            # Ladybird sends no evaluationResult when the script throws, so an
            # exception and a dead console look the same from here.
            raise RuntimeError("no evaluation result: the script threw, or the console did not answer")
        if result.get("hasException"):
            raise RuntimeError(result.get("exceptionMessage") or "the script threw")
        return result.get("result")


# -------------------------------------------------------------------- helpers


def devtools_port(explicit: int | None) -> int | None:
    if explicit:
        return explicit
    from_environment = os.environ.get("LADYCTL_PORT")
    if from_environment:
        return int(from_environment)
    try:
        with open(PORT_FILE) as file:
            return int(file.read().strip())
    except (OSError, ValueError):
        return None


def no_port_message() -> str:
    return f"no devtools port known: start Ladybird with --devtools=PORT or write the port to {PORT_FILE}"


def connect(explicit_port: int | None) -> RDP:
    port = devtools_port(explicit_port)
    if port is None:
        sys.exit(no_port_message())
    try:
        return RDP(port)
    except OSError as error:
        sys.exit(f"cannot reach the devtools server on {port}: {error}")


def emit(args, payload) -> None:
    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    elif isinstance(payload, str):
        print(payload)
    else:
        print(json.dumps(payload, ensure_ascii=False))


# ------------------------------------------------------------------- commands


def command_tabs(args) -> None:
    connection = connect(args.port)
    reply = connection.request(type="listTabs")
    tabs = [
        {"title": tab.get("title"), "url": tab.get("url"), "actor": tab.get("actor")}
        for tab in reply.get("tabs") or []
    ]
    if args.json:
        print(json.dumps(tabs, indent=2, ensure_ascii=False))
    else:
        for tab in tabs:
            print(f"{tab['title'] or '(untitled)'} — {tab['url']}")


def command_url(args) -> None:
    try:
        connection = connect(args.port)
    except SystemExit:
        url = status_line_url()
        if url is None:
            raise
        emit(args, {"url": url, "source": "status-line"} if args.json else url)
        return
    url = connection.tab()["url"]
    emit(args, {"url": url, "source": "devtools"} if args.json else url)


def command_title(args) -> None:
    connection = connect(args.port)
    emit(args, connection.tab().get("title") or "")


def command_open(args) -> None:
    port = devtools_port(args.port)
    if port is not None:
        try:
            connection = RDP(port)
            reply = connection.request(to=connection.tab()["actor"], type="navigateTo", url=args.url)
            if "error" not in reply:
                connection.close()
                emit(args, {"opened": args.url, "via": "devtools"})
                return
            connection.close()
        except (OSError, RuntimeError, TimeoutError):
            pass
    apc("open", args.url)
    emit(args, {"opened": args.url, "via": "apc"})


def command_history(args) -> None:
    connection = connect(args.port)
    frame = connection.frame()
    reply = connection.request(to=frame["actor"], type="goBack" if args.direction == "back" else "goForward")
    if "error" in reply:
        sys.exit(reply["error"])
    emit(args, {"direction": args.direction})


def command_reload(args) -> None:
    connection = connect(args.port)
    frame = connection.frame()
    reply = connection.request(to=frame["actor"], type="reload")
    if "error" in reply:
        sys.exit(reply["error"])
    emit(args, {"reloaded": True})


def command_eval(args) -> None:
    connection = connect(args.port)
    emit(args, connection.evaluate(args.script))


LINKS_SCRIPT = """JSON.stringify([...document.links]
  .map(a => ({text: (a.textContent || '').replace(/\\s+/g, ' ').trim().slice(0, 120), href: a.href}))
  .filter(a => a.href.startsWith('http'))
  .slice(0, %d))"""

# A ref such as e3 names a control the last snapshot numbered, not "the third
# control now": pages reorder themselves, and a page that changed under a
# caller should fail rather than click whatever moved into that place.
REF = re.compile(r"e[0-9]+")

# Resolves the target of a click or a focus into `el` and brings it into view.
# Selectors are matched with querySelector, refs through the marks a snapshot
# left behind.
FIND_SCRIPT = """const target = %s;
const el = /^e[0-9]+$/.test(target)
  ? document.querySelector('[data-lb-ref="' + target + '"]')
  : document.querySelector(target);
if (!el) return 'missing';
el.scrollIntoView({block: 'center', inline: 'center'});
"""

CLICK_SCRIPT = "(() => {" + FIND_SCRIPT + """
const box = el.getBoundingClientRect();
const at = {bubbles: true, cancelable: true, composed: true, view: window, button: 0,
            clientX: box.left + box.width / 2, clientY: box.top + box.height / 2};
// A click is a sequence. Menus and drag targets listen for the pointer events
// that come before the click, and a bare click() never produces them.
const Pointer = window.PointerEvent || MouseEvent;
el.dispatchEvent(new Pointer('pointerdown', at));
el.dispatchEvent(new MouseEvent('mousedown', at));
if (el.focus) el.focus();
el.dispatchEvent(new Pointer('pointerup', at));
el.dispatchEvent(new MouseEvent('mouseup', at));
el.click();
return 'clicked';
})()"""

FOCUS_SCRIPT = "(() => {" + FIND_SCRIPT + """
el.focus();
if (%s) {
  if ('value' in el) {
    // The setter on the prototype is the one a framework has wrapped; assigning
    // to el.value directly can leave its model out of step with the field.
    const setter = Object.getOwnPropertyDescriptor(Object.getPrototypeOf(el), 'value');
    if (setter && setter.set) setter.set.call(el, ''); else el.value = '';
    el.dispatchEvent(new Event('input', {bubbles: true}));
  } else if (el.isContentEditable) {
    el.textContent = '';
  }
}
return (document.activeElement === el || el.contains(document.activeElement)) ? 'focused' : 'unfocused';
})()"""

# Every control a person could operate, numbered in document order. A control
# that is not drawn cannot be clicked, so it is left out rather than offered.
SNAPSHOT_SCRIPT = """(() => {
  for (const el of document.querySelectorAll('[data-lb-ref]')) el.removeAttribute('data-lb-ref');
  const selector = ['a[href]', 'button', 'input:not([type=hidden])', 'select', 'textarea', 'summary',
    '[contenteditable=""]', '[contenteditable=true]', '[role=button]', '[role=link]', '[role=checkbox]',
    '[role=radio]', '[role=tab]', '[role=menuitem]', '[role=option]', '[role=switch]', '[role=textbox]',
    '[role=combobox]', '[role=searchbox]', '[tabindex]:not([tabindex="-1"])'].join(',');
  const kind = el => {
    const role = el.getAttribute('role');
    if (role) return role;
    const tag = el.tagName.toLowerCase();
    if (tag === 'input') {
      const type = (el.getAttribute('type') || 'text').toLowerCase();
      if (type === 'checkbox' || type === 'radio') return type;
      if (['submit', 'button', 'reset', 'image'].includes(type)) return 'button';
      return type === 'text' ? 'text' : type;
    }
    if (tag === 'a') return 'link';
    if (tag === 'textarea' || el.isContentEditable) return 'text';
    return tag;
  };
  const clean = value => (value || '').replace(/\\s+/g, ' ').trim().slice(0, 80);
  const byId = id => { const el = document.getElementById(id); return el ? el.textContent : ''; };
  const label = el => {
    const named = el.getAttribute('aria-labelledby');
    return clean(el.getAttribute('aria-label'))
      || clean(named && named.split(/\\s+/).map(byId).join(' '))
      || clean(el.labels && [...el.labels].map(l => l.textContent).join(' '))
      || clean(el.getAttribute('placeholder'))
      || clean(el.innerText)
      || clean(el.getAttribute('title'))
      || clean(el.getAttribute('alt'))
      || clean(['submit', 'button', 'reset'].includes(el.type) ? el.value : '')
      || clean(el.getAttribute('name'));
  };
  const elements = [];
  for (const el of document.querySelectorAll(selector)) {
    if (!el.getClientRects().length) continue;
    const style = getComputedStyle(el);
    if (style.visibility === 'hidden' || style.display === 'none') continue;
    const ref = 'e' + (elements.length + 1);
    el.setAttribute('data-lb-ref', ref);
    const flags = [];
    if (el.checked || el.getAttribute('aria-checked') === 'true') flags.push('checked');
    if (el.disabled || el.getAttribute('aria-disabled') === 'true') flags.push('disabled');
    if (el === document.activeElement) flags.push('focused');
    const filled = 'value' in el && !['checkbox', 'radio', 'submit', 'button'].includes(el.type) && el.value;
    elements.push({ref: ref, kind: kind(el), label: label(el),
                   value: filled ? String(el.value).slice(0, 80) : null, flags: flags});
  }
  return JSON.stringify({
    title: document.title,
    url: location.href,
    elements: elements,
    text: (document.body ? document.body.innerText : '').replace(/\\n{3,}/g, '\\n\\n').trim(),
  });
})()"""


def command_links(args) -> None:
    connection = connect(args.port)
    raw = connection.evaluate(LINKS_SCRIPT % args.limit) or "[]"
    links = json.loads(raw)
    title = connection.tab().get("title") or ""
    if args.json:
        print(json.dumps({"title": title, "links": links}, indent=2, ensure_ascii=False))
        return
    for link in links:
        print(f"{link['text'] or '(no text)'} — {link['href']}")


def command_click(args) -> None:
    connection = connect(args.port)
    outcome = connection.evaluate(CLICK_SCRIPT % json.dumps(args.target))
    # A target that matches nothing is a failed click, not a successful no-op:
    # a caller that goes on to read the page would be reading the wrong page.
    if outcome != "clicked":
        sys.exit(missing_target(args.target))
    emit(args, outcome)


def command_snapshot(args) -> None:
    connection = connect(args.port)
    raw = connection.evaluate(SNAPSHOT_SCRIPT) or "{}"
    page = json.loads(raw)
    elements = page.get("elements") or []
    text = page.get("text") or ""
    if args.max and len(text) > args.max:
        text = text[: args.max] + f"\n…({len(page.get('text') or '') - args.max} more characters; use --max 0 for all)"
        page["text"] = text
    if args.list:
        # One control per line and nothing else, so a picker can read this
        # without a JSON parser: ref, kind, label, then flags when there are any.
        for element in elements:
            line = "\t".join([element["ref"], element["kind"], element["label"]])
            if element["flags"]:
                line += "\t" + ",".join(element["flags"])
            print(line)
        return
    if args.json:
        emit(args, page)
        return
    print(f"{page.get('title') or '(untitled)'}\n{page.get('url') or ''}")
    print("\nElements:")
    if not elements:
        print("(none)")
    for element in elements:
        value = f" = {json.dumps(element['value'])}" if element.get("value") else ""
        flags = "".join(f" [{flag}]" for flag in element["flags"])
        print(f"[{element['ref']}] {element['kind']} {json.dumps(element['label'], ensure_ascii=False)}{value}{flags}")
    print(f"\nText:\n{text or '(none)'}")


def command_type(args) -> None:
    block = pane_block()
    connection = connect(args.port)
    outcome = connection.evaluate(FOCUS_SCRIPT % (json.dumps(args.target), "true" if args.clear else "false"))
    connection.close()
    if outcome == "missing":
        sys.exit(missing_target(args.target))
    if outcome != "focused":
        sys.exit(f"{args.target} did not take focus, so the text would go to the page")
    # The text goes in as keystrokes: a field that reacts to input events
    # (autocomplete, validation, a framework's own model) only sees those.
    if args.text:
        # `--` stops rex reading a leading '-' as a flag.
        typed = rex("send", "-b", block, "--", args.text, check=False)
        if typed.returncode != 0:
            sys.exit(f"could not type into {block}: {typed.stderr.strip()}")
    if args.submit:
        send_keys(block, ["enter"])
    emit(args, {"typed": args.text or "", "submitted": bool(args.submit)})


def command_press(args) -> None:
    block = pane_block()
    send_keys(block, args.keys)
    emit(args, {"pressed": args.keys})


def command_wait(args) -> None:
    port = devtools_port(args.port)
    if port is None:
        sys.exit(no_port_message())
    conditions = ["document.readyState === 'complete'"]
    wanted = "the page"
    if args.selector:
        conditions.append(f"!!document.querySelector({json.dumps(args.selector)})")
        wanted += f" to show {args.selector}"
    if args.text:
        conditions.append(f"(document.body ? document.body.innerText : '').includes({json.dumps(args.text)})")
        wanted += f" to mention {json.dumps(args.text)}"
    script = "(" + " && ".join(conditions) + ")"
    deadline = time.monotonic() + args.timeout
    while True:
        connection = None
        try:
            connection = RDP(port, timeout=5)
            if connection.evaluate(script) is True:
                emit(args, {"waited": True, "selector": args.selector, "text": args.text})
                return
        except (OSError, ConnectionError, RuntimeError, TimeoutError):
            # The page is between documents: the console actor it was reached
            # through is gone, and the next attempt attaches to the new one.
            pass
        finally:
            if connection:
                connection.close()
        if time.monotonic() > deadline:
            sys.exit(f"waited {args.timeout}s for {wanted}")
        time.sleep(0.2)


def missing_target(target: str) -> str:
    """Why a click or a focus found nothing, in the caller's own terms."""
    if REF.fullmatch(target):
        return f"no element {target}; the snapshot may be older than the page, so take another"
    return f"no element matches {target}"


def command_chrome(args) -> None:
    """Ask terminal mode to hide or show its own status line (needs the status-line patch)."""
    apc("chrome", "off" if args.state == "off" else "on")
    emit(args, {"status_line": args.state})


def command_quit(args) -> None:
    port = devtools_port(args.port)
    if port is not None:
        try:
            connection = RDP(port)
            connection.send(to=connection.tab()["actor"], type="detach")
            connection.close()
        except OSError:
            pass
    apc("quit")
    emit(args, {"quit": True})


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--port", type=int, help="devtools port (default: the one the Rex module recorded)")
    parser.add_argument("--json", action="store_true", help="print machine-readable output")
    subparsers = parser.add_subparsers(dest="command", required=True)

    def add(name, help_text, handler, **kwargs):
        sub = subparsers.add_parser(name, help=help_text, **kwargs)
        # SUPPRESS keeps the top-level --port/--json when they are given before the subcommand.
        sub.add_argument("--port", type=int, default=argparse.SUPPRESS, help="devtools port")
        sub.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="print machine-readable output")
        sub.set_defaults(handler=handler)
        return sub

    add("tabs", "list the open tabs with their real titles and URLs", command_tabs)
    add("url", "print the current address", command_url)
    add("title", "print the current page title", command_title)
    add("open", "navigate to a URL", command_open).add_argument("url")
    history = add("back", "go back in history", command_history)
    history.set_defaults(direction="back")
    forward = add("forward", "go forward in history", command_history)
    forward.set_defaults(direction="forward")
    add("reload", "reload the page", command_reload)
    add("eval", "evaluate JavaScript in the page", command_eval).add_argument("script")
    add("links", "list the links on the page", command_links).add_argument(
        "--limit", type=int, default=200, help="how many links to report (default 200)"
    )
    snapshot = add("snapshot", "number the controls on the page (e1, e2, …) and read its text", command_snapshot)
    snapshot.add_argument("--list", action="store_true", help="print one control per line: ref, kind, label, flags")
    snapshot.add_argument("--max", type=int, default=20000, help="cap the page text at this many characters (0 for all)")
    add("click", "click an element: a ref from snapshot such as e2, or a CSS selector", command_click).add_argument(
        "target"
    )
    typing = add("type", "focus an element and type into it with real keystrokes", command_type)
    typing.add_argument("target")
    typing.add_argument("text", nargs="?", default="", help="text to type (default: none, just focus)")
    typing.add_argument("--clear", action="store_true", help="empty the field first")
    typing.add_argument("--submit", action="store_true", help="press enter afterwards")
    add("press", "press keys in the pane, such as enter, tab, escape or ctrl+a", command_press).add_argument(
        "keys", nargs="+"
    )
    waiting = add("wait", "wait for the page to load, and for --selector or --text if given", command_wait)
    waiting.add_argument("--selector", help="wait until this CSS selector matches")
    waiting.add_argument("--text", help="wait until the visible text contains this")
    waiting.add_argument("--timeout", type=float, default=30, help="seconds to wait (default 30)")
    chrome = add("chrome", "hide or show terminal mode's own status line", command_chrome)
    chrome.add_argument("state", choices=["on", "off"])
    add("quit", "close the browser", command_quit)

    args = parser.parse_args()
    try:
        args.handler(args)
    except (RuntimeError, TimeoutError, ConnectionError) as error:
        sys.exit(str(error))
    return 0


if __name__ == "__main__":
    sys.exit(main())
